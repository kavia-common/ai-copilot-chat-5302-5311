# REQUIRED: Your Google Gemini API Key
# Get one at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3001

# CORS Origins (comma-separated)
# Include both local and preview URLs, both HTTP and HTTPS if needed
# Local development example: http://localhost:3000
# Preview environment example: https://vscode-internal-29933-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-29933-beta.beta01.cloud.kavia.ai:4000
CORS_ORIGINS=http://localhost:3000,https://vscode-internal-29933-beta.beta01.cloud.kavia.ai:3000,https://vscode-internal-29933-beta.beta01.cloud.kavia.ai:4000
